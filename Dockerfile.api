FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod ./
RUN go mod download
COPY . .
# Build the IVF index from the reference vectors (replaces the old KD-tree)
RUN CGO_ENABLED=0 go run ./cmd/buildivf resources/references.json.gz index.bin
# Build the API binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /api ./cmd/api

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /api /api
COPY --from=builder /app/index.bin /data/index.bin
ENV INDEX_PATH=/data/index.bin
EXPOSE 8081
ENTRYPOINT ["/api"]
