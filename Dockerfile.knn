FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /knn ./cmd/knn

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /knn /knn
COPY resources/references.json.gz /data/references.json.gz
ENV REFS_PATH=/data/references.json.gz
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/knn"]
